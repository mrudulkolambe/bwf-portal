generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PARTNER
  CONSUMER
}

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  phoneNumber String   @unique
  email       String?  @unique
  name        String?
  image       String?
  role        Role     @default(CONSUMER)
  otp         String?
  otpExpires  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}



